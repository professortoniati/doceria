# ── Sistema Operacional ───────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ── Editores e IDEs ──────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (WebStorm, PhpStorm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / NeoVim
*.swp
*.swo
Session.vim
.netrwhist

# Emacs
\#*\#

# ── Node.js (caso venha a usar ferramentas build) ─────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn-integrity
package-lock.json
yarn.lock

# ── Variaveis de Ambiente e Segredos ─────────────────────
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local
*.pem
*.key
*.cert
secrets.json
config/secrets.*

